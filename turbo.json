{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": []
    },
    "build": {
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    }
  },
  "concurrency": "12"
}