# Crash Test production environment. Copy to .env.production (never commit it) or
# enter the same keys in your host's dashboard (Render, Railway, Fly…).

# ---- access (required when the URL is reachable by others) ----
# Everyone opening the app is asked for this password (any user name).
# Shared report links (/r/…) and the health check stay public.
# Required, at least 12 characters: e.g. `openssl rand -base64 24`
APP_PASSWORD=

# ---- database ----
# docker-compose.prod.yml builds DATABASE_URL from these three:
POSTGRES_USER=crash
POSTGRES_PASSWORD=
POSTGRES_DB=crashtest
# Anywhere else, set the full URL of your PostgreSQL instead (the database is migrated on start):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
#  - Use the direct (session) connection, not a pooler URL (Neon "-pooler", Supabase :6543):
#    live updates use LISTEN/NOTIFY and migrations use session locks.
#  - Providers with their own TLS certificate authority (DigitalOcean, RDS, Supabase):
#    add ?sslmode=require&uselibpqcompat=true (or sslmode=no-verify) if the connection fails
#    with "self-signed certificate in certificate chain".
#  - URL-encode special characters in the password (@ → %40, / → %2F, # → %23).

# ---- graph8 ----
# Runs need a developer-sandbox key (g8_sbx_…) and the sandbox's base URL; a live key is read-only here.
GRAPH8_API_KEY=
GRAPH8_BASE_URL=
# Runs refuse any other workspace: the org_id from GET /sandbox/status (or `npm run gates`)
GRAPH8_WORKSPACE_ID=
# on = graph8 copilot (uses credits) with code fallbacks · off = rules only
GRAPH8_AI=on

# ---- fake buyers ----
TEST_DOMAIN=crashtest.example
DEMO_OWNER_EMAIL=
REENGAGE_OWNER_EMAIL=

# ---- runtime ----
LOG_LEVEL=info
# Public port inside the container (hosts like Render and Railway set PORT themselves)
PORT=3000
# docker-compose.prod.yml: host port for the app, and your domain for --profile https
APP_PORT=3000
# With --profile https: 127.0.0.1 keeps plain HTTP on the app port private (Caddy serves HTTPS)
APP_BIND=0.0.0.0
DOMAIN=

# ---- timings (ms): tune after `npm run gates` measures real send latency ----
OUTBOX_TIMEOUT_MS=180000
OUTBOX_POLL_MS=5000
NEGATIVE_WAIT_MS=60000
