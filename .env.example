# Crash Test environment (build plan v4 §27). Copy to .env and fill in. Never commit .env.

# ---- database ----
DATABASE_URL=postgresql://crash:crash@localhost:5432/crashtest

# ---- graph8 (the only external key) ----
GRAPH8_API_KEY=
GRAPH8_API_ID=
GRAPH8_BASE_URL=
# Runs refuse any other workspace (the org_id from `npm run gates`)
GRAPH8_WORKSPACE_ID=

# ---- AI: graph8 copilot with the key above (on) or deterministic rules (off) ----
GRAPH8_AI=on

# ---- fake buyers + demo seeding ----
TEST_DOMAIN=crashtest.example
DEMO_OWNER_EMAIL=
REENGAGE_OWNER_EMAIL=

# ---- stack ----
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:3000
# The browser calls the web app, which proxies /api and /socket.io to the API (next.config.ts).
# Only set this to send the browser straight to an API on another origin.
NEXT_PUBLIC_API_URL=
# Local dev: leave empty (no password). Production: see .env.production.example
APP_PASSWORD=
LOG_LEVEL=info

# ---- timings (ms): tune after `npm run gates` measures real send latency ----
OUTBOX_TIMEOUT_MS=180000
OUTBOX_POLL_MS=5000
NEGATIVE_WAIT_MS=60000
