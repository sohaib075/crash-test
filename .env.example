# ---- graph8 (the only external key; server + worker only, never the browser) ----
GRAPH8_API_KEY=
GRAPH8_BASE_URL=
# Refuse to run unless /sandbox/status org_id matches (hackathon: demo workspace only)
GRAPH8_WORKSPACE_ID=
# Fake buyers are only ever created on this domain
TEST_DOMAIN=crashtest.example
# AI steps use graph8 copilot with the same key (costs credits). off = rules only
GRAPH8_AI=on

# ---- demo seeding (npm run seed:graph8) ----
DEMO_OWNER_EMAIL=
REENGAGE_OWNER_EMAIL=

# ---- stack ----
DATABASE_URL=postgresql://crash:crash@localhost:5432/crashtest
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info

# ---- timings (ms); tune after `npm run gates` measures real send latency ----
OUTBOX_TIMEOUT_MS=180000
OUTBOX_POLL_MS=5000
NEGATIVE_WAIT_MS=60000
