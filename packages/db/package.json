{
  "name": "@crash/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env src/pg.ts",
    "generate": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "migrate:new": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js migrate dev --skip-seed --name",
    "studio": "node --env-file-if-exists=../../.env ../../node_modules/prisma/build/index.js studio",
    "seed": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.local src/seed.ts",
    "typecheck": "tsc -p ."
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@crash/shared": "*",
    "@prisma/client": "^6",
    "embedded-postgres": "16.14.0-beta.17",
    "pg": "^8"
  },
  "devDependencies": {
    "prisma": "^6",
    "@types/pg": "^8"
  }
}