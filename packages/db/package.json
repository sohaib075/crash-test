{
  "name": "@crash/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev --name init --skip-seed",
    "deploy": "prisma migrate deploy",
    "seed": "tsx --env-file-if-exists=../../.env.local src/seed.ts",
    "typecheck": "tsc -p .",
    "dev": "tsx src/pg.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@crash/shared": "*",
    "@prisma/client": "^6",
    "embedded-postgres": "16.14.0-beta.17",
    "pg": "^8"
  },
  "devDependencies": {
    "prisma": "^6",
    "@types/pg": "^8"
  }
}