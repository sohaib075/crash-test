{
  "name": "crash-test",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db": "npm run dev -w @crash/db",
    "db:migrate": "npm run migrate -w @crash/db",
    "dev": "turbo run dev",
    "dev:server": "npm run dev -w @crash/server",
    "dev:worker": "npm run dev -w @crash/worker",
    "dev:web": "npm run dev -w @crash/web",
    "build": "npm run generate -w @crash/db && npm run build -w @crash/web",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc -p . && turbo run typecheck",
    "lint": "npm run lint -w @crash/web",
    "test": "vitest run",
    "gates": "tsx --env-file-if-exists=.env scripts/gates.ts",
    "seed:graph8": "tsx --env-file-if-exists=.env scripts/seed-graph8.ts",
    "reset:demo": "tsx --env-file-if-exists=.env scripts/reset-demo.ts",
    "db:studio": "npm run studio -w @crash/db",
    "db:new-migration": "npm run migrate:new -w @crash/db --",
    "db:seed": "npm run seed -w @crash/db",
    "db:check": "tsx --env-file-if-exists=.env scripts/db-check.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "turbo": "^2",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12"
  }
}
